# Templated by the nginx:alpine image's built-in envsubst entrypoint
# (files under /etc/nginx/templates/*.template are rendered to
# /etc/nginx/conf.d/*.conf on container start, substituting $N8N_HOST and
# $ADMIN_GUI_HOST from the container environment).
#
# First run (before a certificate exists) should use the HTTP-only server
# blocks below with the ACME challenge location, obtain the certificate via
# the certbot service, then uncomment the HTTPS server blocks and reload.
# See docker/nginx/README.md.

server {
    listen 80;
    server_name ${N8N_HOST} ${ADMIN_GUI_HOST};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${N8N_HOST};

    ssl_certificate     /etc/letsencrypt/live/${N8N_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${N8N_HOST}/privkey.pem;

    location / {
        proxy_pass http://n8n:5678;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # n8n webhooks/UI use WebSocket-based push updates
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

server {
    listen 443 ssl;
    server_name ${ADMIN_GUI_HOST};

    ssl_certificate     /etc/letsencrypt/live/${N8N_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${N8N_HOST}/privkey.pem;

    location / {
        proxy_pass http://admin-gui:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
