# Only needed if running admin-gui standalone (outside docker compose),
# e.g. `node server.js` during local development. When run via
# `docker compose up`, these come from the root .env file instead.
PORT=3000
ADMIN_GUI_USER=exco
ADMIN_GUI_PASSWORD=change_me_local_dev_only
SESSION_SECRET=change_me_local_dev_only
DEFAULT_BRANCH_SLUG=ado-ekiti

# admin-gui connects to Postgres directly as the least-privilege
# nba_app_runtime role (db/migrations/010_nba_app_runtime_role.sql) —
# no more proxying through n8n webhooks.
PGHOST=localhost
PGPORT=5432
PGUSER=nba_app_runtime
PGPASSWORD=change_me_local_dev_only
PGDATABASE=nba_send
# "disable" for a local Postgres without TLS; "require" against Supabase or
# any TLS-terminated production database.
PGSSLMODE=disable

# Shared secret embedded as a URL path segment on the inbound provider
# webhook routes (/webhooks/brevo-delivery-status/:secret,
# /webhooks/sendchamp-whatsapp-reply/:secret).
WEBHOOK_SHARED_SECRET=change_me_local_dev_only
