# Copy this file to .env and fill in real values before running docker compose.
# All values below are safe local-dev defaults — replace before any real deployment.

# ---------------------------------------------------------------------------
# Postgres (shared instance: n8n's own execution DB + the application DB)
# ---------------------------------------------------------------------------
POSTGRES_USER=nba_admin
POSTGRES_PASSWORD=change_me_local_dev_only
POSTGRES_DB=n8n_state
APP_DB_NAME=nba_send
POSTGRES_PORT=5432
# Password for the least-privilege nba_app_runtime role (see
# db/migrations/010_nba_app_runtime_role.sql) that n8n's Postgres credential
# and admin-gui both actually connect as, so Row-Level Security is genuinely
# enforced instead of bypassed by a table-owner role. Set by db/migrate.sh.
NBA_APP_RUNTIME_PASSWORD=change_me_local_dev_only

# ---------------------------------------------------------------------------
# n8n
# ---------------------------------------------------------------------------
N8N_VERSION=latest
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PORT=5678
# Option B (VPS) only — second public hostname for the admin GUI, and the
# email Let's Encrypt sends renewal/expiry notices to. Unused locally.
ADMIN_GUI_HOST=broadcast.localhost
LETSENCRYPT_EMAIL=
# Base URL n8n uses to construct webhook URLs it reports back to you.
WEBHOOK_URL=http://localhost:5678/
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_local_dev_only
# Vestigial: only used by the parked workflows in n8n/workflows/superseded/
# (kept in case n8n's webhook-registration bug is ever fixed upstream and
# it's worth moving this logic back into n8n — see that directory's
# README.md). Not read by anything in the current architecture.
N8N_WEBHOOK_SECRET=change_me_local_dev_only

# ---------------------------------------------------------------------------
# Admin GUI
# ---------------------------------------------------------------------------
ADMIN_GUI_PORT=3000
ADMIN_GUI_USER=exco
ADMIN_GUI_PASSWORD=change_me_local_dev_only
SESSION_SECRET=change_me_local_dev_only
# Shared secret embedded as a URL path segment on admin-gui's inbound
# provider webhook routes (/webhooks/brevo-delivery-status/:secret,
# /webhooks/sendchamp-whatsapp-reply/:secret) — providers can't do session
# auth, so this is what stands in for it. Use a long random value.
WEBHOOK_SHARED_SECRET=change_me_local_dev_only
# Vestigial: only used by the parked workflows in n8n/workflows/superseded/.
# Not read by anything in the current architecture — admin-gui now talks to
# Postgres directly instead of proxying through n8n. See that directory's
# README.md.
N8N_WEBHOOK_BASE=http://n8n:5678/webhook

# ---------------------------------------------------------------------------
# Data source toggle for the broadcast-main n8n workflow
# ---------------------------------------------------------------------------
# "postgres" is the tested path in local dev. "sheets" requires a live
# Google Sheets OAuth2 credential configured inside n8n (see n8n/README.md).
DATA_SOURCE=postgres
BROADCAST_BATCH_SIZE=50
BROADCAST_BATCH_DELAY_SECONDS=2

# ---------------------------------------------------------------------------
# Brevo — email only (Brevo's free tier doesn't support WhatsApp; see
# Sendchamp below for that channel). See docs/PROVIDERS_SETUP.md.
# ---------------------------------------------------------------------------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=notices@example.org

# ---------------------------------------------------------------------------
# Sendchamp — WhatsApp only (see docs/PROVIDERS_SETUP.md for where to get
# each value: connecting a sender number, creating and getting a Meta-approved
# template).
# ---------------------------------------------------------------------------
# Not read via $env by the workflow itself (auth happens through the
# "Sendchamp API" Header Auth n8n credential, entered manually in the n8n
# UI) — kept here as the source-of-truth value to copy into that credential.
SENDCHAMP_API_KEY=
SENDCHAMP_API_BASE_URL=https://api.sendchamp.com/api/v1
SENDCHAMP_WHATSAPP_SENDER_NUMBER=
SENDCHAMP_WHATSAPP_TEMPLATE_CODE=

# ---------------------------------------------------------------------------
# Multitexter — SMS (see docs/PROVIDERS_SETUP.md). Multitexter authenticates
# with account email+password in the request body, not an API key header.
# ---------------------------------------------------------------------------
MULTITEXTER_EMAIL=
MULTITEXTER_PASSWORD=

# ---------------------------------------------------------------------------
# Branch defaults (seed data uses these; National rollout adds more branches
# as rows in the `branches` table rather than new env vars)
# ---------------------------------------------------------------------------
DEFAULT_BRANCH_SLUG=ado-ekiti
DEFAULT_SMS_SENDER_ID=NBA-ADO
